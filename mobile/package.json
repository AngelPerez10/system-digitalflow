{
  "name": "digitalflow-tecnico",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.17",
    "babel-preset-expo": "^57.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.2.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:dev": "pnpm dlx eas-cli@^22.5.0 build -p android --profile development",
    "build:apk": "pnpm dlx eas-cli@^22.5.0 build -p android --profile preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/android",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
  }
}
