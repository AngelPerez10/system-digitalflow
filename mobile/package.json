{
  "name": "digitalflow-tecnico",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.17",
    "babel-preset-expo": "^54.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.18",
    "react-test-renderer": "^19.2.8",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:dev": "pnpm dlx eas-cli@^22.5.0 build -p android --profile development",
    "build:apk": "pnpm dlx eas-cli@^22.5.0 build -p android --profile preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/android",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
  }
}
